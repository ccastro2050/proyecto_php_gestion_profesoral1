          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ingenieria de Sistemas\",\n  \"tipo\": \"Programa Academico\",\n  \"nivel\": \"Pregrado\",\n  \"fecha_creacion\": \"2005-01-15\",\n  \"numero_cohortes\": \"40\",\n  \"cant_graduados\": \"1250\",\n  \"fecha_actualizacion\": \"2026-01-30\",\n  \"ciudad\": \"Medellin\",\n  \"facultad\": 104,\n  \"fecha_cierre\": null\n}"
