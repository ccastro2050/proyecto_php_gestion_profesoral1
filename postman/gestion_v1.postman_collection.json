        "description": "Dice si la API está viva y qué versión es."
      }
    },
    {
      "name": "2. Listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8113/api/programa?limite=5",
          "host": [
            "localhost"
          ],
          "port": "8113",
          "path": [
            "api",
            "programa?limite=5"
          ]
        },
        "description": "Responde 200 con el sobre {tabla, limite, total, datos}. Con la tabla vacía respondería 204 SIN cuerpo, que no es un error — pero no se llega ahí arrancando: la tabla trae 191 filas."
      }
    },
    {
      "name": "3. Crear",
      "request": {
        "method": "POST",
        "header": [
