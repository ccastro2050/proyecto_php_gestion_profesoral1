            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8113/api/programa",
          "host": [
            "localhost"
          ],
          "port": "8113",
          "path": [
            "api",
            "programa"
          ]
        },
        "description": "Todos los campos, incluida la llave. Falta uno → 422. Llave repetida → 500 con el mensaje del motor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 9001,\n  \"nombre\": \"Ingenieria de Sistemas\",\n  \"tipo\": \"Programa Academico\",\n  \"nivel\": \"Pregrado\",\n  \"fecha_creacion\": \"2005-01-15\",\n  \"numero_cohortes\": \"40\",\n  \"cant_graduados\": \"1250\",\n  \"fecha_actualizacion\": \"2026-01-30\",\n  \"ciudad\": \"Medellin\",\n  \"facultad\": 104,\n  \"fecha_cierre\": null\n}"
